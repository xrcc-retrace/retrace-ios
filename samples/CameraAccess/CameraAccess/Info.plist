<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Retrace</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>CameraAccess</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cameraaccess</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>cameraaccess://</string>
		<!-- MetaAppID = "0" + ClientToken empty is the Dev Mode workaround.
		     Bypasses per-app provisioning at the Wearables Developer Center
		     so the DAT bundle on the glasses provisions against a generic
		     dev profile instead of our specific MetaAppID. Required because
		     our app isn't enrolled in WDC with Active User tester status.
		     Swap these back to $(META_APP_ID) / $(CLIENT_TOKEN) once we
		     have real WDC credentials. See memory/reference_mrbd_dat_on_glasses_install.md. -->
		<key>ClientToken</key>
		<string></string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<!-- DAMEnabled = Display Access Mode. Without this, MWDATDisplay's
		     capability.start() silently no-ops (Display.state stays .stopped
		     and no transitions fire). Required for any lens rendering. -->
		<key>DAMEnabled</key>
		<true/>
		<!-- Experiment: the 0.8 binary carries an spdlog file logger
		     (ARCSpdlogFileLogHandler → MetaWearablesDAT.log) plus "Logging"
		     and "LogLevel" key strings, but no public configure API. If this
		     dict is honored, the console prints "MWDAT Logger initialized
		     with ARCSpdlogFileLogHandler" at launch and the SDK's link-layer
		     join trace lands in the app container. Harmless if ignored. -->
		<key>Logging</key>
		<dict>
			<key>LogLevel</key>
			<string>debug</string>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_retrace._tcp</string>
		<!-- DAT 0.8 WiFi video transport opt-in: `_bonjour._tcp` lets the SDK
		     discover the glasses over the local network; without it the SDK
		     silently stays on Bluetooth Classic. History: removed (BT pin)
		     after field captures showed video starving with NO observable
		     WiFi join; RE-ADDED 2026-07-01 after finding the likely root
		     cause of those dead joins — the Meta AI app has a per-glasses
		     "allow WiFi connection" permission in glasses settings that had
		     never been enabled. That glasses-side gate is a hard prerequisite
		     for the SoftAP join (undocumented; matches Meta's repo discussion
		     #37 "user flow similar to how Meta AI does downloads"). If video
		     starves again WITH the Meta AI toggle on, remove this entry to
		     re-pin BT. -->
		<string>_bonjour._tcp</string>
		<!-- LocalNetworkPermission probe (self-published + self-discovered
		     to detect the Local Network grant; iOS has no query API). -->
		<string>_retrace-lnp._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Retrace uses your iPhone camera to record procedures and to let the AI coach see your work when you choose the iPhone capture mode.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Retrace needs local network access to discover the server on your Wi-Fi network and to stream video from your glasses over Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Retrace needs microphone access to record narration during expert recordings and to hear you during AI coaching sessions.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This app needs access to save photos captured from your glasses.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Retrace needs access to your photo library so you can upload an existing video as an expert procedure.</string>
	<key>UIAppFonts</key>
	<array>
		<string>GolosText-Regular.ttf</string>
		<string>GolosText-Medium.ttf</string>
		<string>GolosText-SemiBold.ttf</string>
		<string>GolosText-Bold.ttf</string>
		<string>GolosText-ExtraBold.ttf</string>
		<string>GolosText-Black.ttf</string>
		<string>Inter-Variable.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
